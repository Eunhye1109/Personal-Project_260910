# ─────────────────────────────────────────────
# 공공데이터포털 인증키
#   마이페이지 > 데이터활용 > Open API > 개발계정 > [API 이름]
#   "일반 인증키(Decoding)" 값을 그대로 붙여넣는다.
#   ※ 이 파일(.env.example)이 아니라 .env 에 넣을 것. .env 는 git에 올라가지 않는다.
# ─────────────────────────────────────────────
DATA_GO_KR_KEY=

# 영등위 비디오물 등급분류정보 조회 서비스 (data.go.kr 15127675)
#   API 페이지 > 아래로 스크롤 > [상세기능] 표 > 엔드포인트(요청주소)
#   https://apis.data.go.kr/... 로 시작하는 주소
KMRB_VIDEO_ENDPOINT=

# 게임물관리위원회 게임 정보 (data.go.kr 15120667) — LINK(연계) 방식
#   포털이 중계하지 않고 게임위 서버를 직접 호출한다.
#   비워두면 아래 기본값을 쓴다.
#   https://www.grac.or.kr/WebService/GameSearchSvc.asmx/game
GRAC_GAME_ENDPOINT=

# ※ NAS(공유 드라이브) 사본에서는 이 파일에 키를 넣지 말 것.
#    스크립트가 실행 시 물어보고, 답은 개인 PC 홈 폴더
#    ~/.gucc_rating_analysis.env 에만 저장한다. docs/집에서_게임위_수집하기.md 참조.
