# API 키 · 자격증명
.env
*.key
secrets.*
config_local.*

# 수집 데이터 (용량 문제로 저장소에 포함하지 않음)
data/raw/
data/interim/
data/processed/
*.parquet
*.csv
# 단, outputs/ 의 작은 참조표(매핑표 등)는 산출물이므로 포함한다
!outputs/*.csv

# 단, 대시보드가 읽는 슬림 사본은 배포에 필요하므로 포함한다 (약 6MB)
# Streamlit Cloud 는 저장소에 있는 파일만 읽는다
!data/dashboard/
!data/dashboard/*.parquet
!data/dashboard/*.json

# 체크포인트 · 로그
checkpoints/
logs/
*.log

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# 엑셀 산출물 — parquet 에서 export_excel.py 로 언제든 다시 만들 수 있고 용량이 크다
# (kmrb_video_260907.xlsx 는 49MB). NAS 사본에는 그대로 둔다
outputs/*.xlsx

# Office 임시 파일
~$*.docx
~$*.xlsx

# 개인 PC 홈 폴더 설정 사본이 실수로 들어오는 경우
.rating_analysis.env

# 통합본 CSV 는 59MB 라 저장소에 두지 않는다. src/make_integrated.py 로 다시 만들 수 있고
# NAS 사본에는 그대로 있다.
outputs/integrated_ratings_*.csv
