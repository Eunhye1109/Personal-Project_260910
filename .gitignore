# API 키 · 자격증명
.env
*.key
secrets.*
config_local.*

# 수집 데이터 (용량 문제로 저장소에 포함하지 않음)
data/raw/
data/interim/
data/processed/
*.parquet
*.csv
# 단, outputs/ 의 작은 참조표(매핑표 등)는 산출물이므로 포함한다
!outputs/*.csv

# 체크포인트 · 로그
checkpoints/
logs/
*.log

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Office 임시 파일
~$*.docx
~$*.xlsx

# 개인 PC 홈 폴더 설정 사본이 실수로 들어오는 경우
.gucc_rating_analysis.env
